# GitHub Node.js .gitignore template baseline
# Reference: https://github.com/github/gitignore/blob/master/Node.gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime
logs/
*.log

# Coverage
coverage/
*.lcov
.nyc_output/
.c8rc

# Environment
.env
.env.local
.env.*.local

# Build & Distribution
dist/
build/
out/
*.tsbuildinfo
.next/
.nuxt/
.cache/
.turbo/
.serverless/

# Temporary & Generated
tmp/
temp/
*.gen
*.ign
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.vscode/launch.json

# Package Manager Locks (optional, team decision)
# Uncomment to ignore lock files in monorepo
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Test artifacts
.mocha.opts
test-results/
junit.xml

# Debugging
.debug
debug.log
