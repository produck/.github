{
  "coverage": {
    "scriptTemplate": "c8 --reporter=lcov --reporter=html --reporter=text-summary npm test"
  },
  "enforce": {
    "sharedScriptsDisallow": [
      "npx c8",
      "c8@latest",
      "npx lerna",
      "lerna@latest",
      "npx prettier",
      "prettier@latest"
    ]
  },
  "schemaVersion": 1,
  "tools": {
    "@eslint/config-helpers": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "@eslint/js": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "@eslint/json": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "@eslint/markdown": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "c8": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "eslint": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "globals": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "husky": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "lerna": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "prettier": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    },
    "typescript-eslint": {
      "allowLatest": false,
      "policy": "pinned",
      "version": "auto"
    }
  },
  "updatedAt": "2026-05-12"
}
