{
  "name": "@produck/eslint-rules",
  "version": "0.3.1",
  "description": "Common eslint rules of Produck team",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/produck/.github.git",
    "directory": "packages/eslint-rules"
  },
  "main": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@eslint/config-helpers": ">=0.6.0",
    "eslint": ">=10.3.0"
  },
  "scripts": {
    "test": "node --test test/index.mjs",
    "coverage": "node --test --experimental-test-coverage test/index.mjs",
    "lint": "eslint src test",
    "verify": "node -e \"import('./src/index.mjs').then(() => console.log('[eslint-rules] package loaded successfully')).catch((e) => { console.error(e); process.exit(1); })\""
  },
  "keywords": [
    "eslint",
    "rules"
  ],
  "author": "ChaosLee",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
