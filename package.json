{
  "name": "@produck/org-policies-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Produck organization policy repository monorepo",
  "workspaces": [
    "packages/agent-toolkit",
    "packages/create-agent-toolkit",
    "packages/eslint-rules"
  ],
  "scripts": {
    "prepare": "husky",
    "deps:install": "npm install",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "lint": "eslint --fix . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit:check": "npm run format:check && npm run lint",
    "type-check": "tsc --noEmit",
    "publish:checks": "npm run format:check && npm run test",
    "publish": "npm run publish:checks && node ./scripts/lerna-publish.mjs",
    "publish:dry-run": "npm run publish:checks && lerna exec --no-private -- npm pack --dry-run",
    "toolkit:verify": "npm --workspace @produck/agent-toolkit run verify",
    "toolkit:pack-check": "npm --workspace @produck/agent-toolkit run pack:check",
    "eslint-rules:verify": "npm --workspace @produck/eslint-rules run verify",
    "eslint-rules:pack-check": "npm --workspace @produck/eslint-rules run pack:check",
    "produck:precommit-check": "npm run format:check && npm run lint"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "lerna": "9.0.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "c8": "11.0.0",
    "@produck/agent-toolkit": "0.3.3"
  }
}
